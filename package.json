{
  "name": "@solidjs/start-devtools",
  "version": "1.0.0-next.8",
  "description": "Development error and server-function tooling for Solid Start mode",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "development": {
        "worker": "./dist/server.js",
        "browser": "./dist/index.js",
        "deno": "./dist/server.js",
        "node": "./dist/server.js",
        "import": "./dist/index.js"
      },
      "default": "./dist/noop.js"
    },
    "./time-travel": {
      "types": "./dist/types/time-travel/index.d.ts",
      "development": {
        "worker": "./dist/time-travel-noop.js",
        "browser": "./dist/time-travel.js",
        "deno": "./dist/time-travel-noop.js",
        "node": "./dist/time-travel-noop.js",
        "import": "./dist/time-travel.js"
      },
      "default": "./dist/time-travel-noop.js"
    }
  },
  "scripts": {
    "build": "rolldown -c",
    "demo": "pnpm build && vite --config examples/demo/vite.config.ts",
    "demo:explorer": "pnpm build && vite --config examples/explorer/vite.config.ts",
    "check": "publint && attw --pack . --profile esm-only",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "release": "pnpm build && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs/solid-start-devtools.git"
  },
  "bugs": {
    "url": "https://github.com/solidjs/solid-start-devtools/issues"
  },
  "homepage": "https://github.com/solidjs/solid-start-devtools#readme",
  "keywords": [
    "solid",
    "solidjs",
    "devtools",
    "server-functions"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.13",
    "solid-js": "^2.0.0-rc.13"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.30.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@playwright/test": "^1.62.1",
    "@solidjs/compiler": "2.0.0-rc.20",
    "@solidjs/vite-plugin": "3.0.0-next.55",
    "@solidjs/web": "^2.0.0-rc.20",
    "@twinkleplop/annotation": "^0.1.5",
    "@twinkleplop/theme-github": "^0.2.2",
    "@twinkleplop/tsx": "^0.1.5",
    "@twinkleplop/typescript": "^0.1.5",
    "@types/node": "^24.0.0",
    "error-stack-parser-es": "^2.0.1",
    "html-to-image": "^1.11.13",
    "oxfmt": "^0.64.0",
    "publint": "^0.3.23",
    "rolldown": "^1.2.4",
    "rolldown-plugin-dts": "^0.28.2",
    "seroval": "^1.6.0",
    "solid-js": "^2.0.0-rc.20",
    "terracotta": "2.0.0-next.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0"
}
